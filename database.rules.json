{
  "rules": {
    ".read": false,
    ".write": false,

    "organizers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'role']) && newData.child('role').val() === 'organizer'"
      }
    },

    "shows": {
      ".read": "auth != null && query.orderByChild === 'organizerId' && query.equalTo === auth.uid",
      ".indexOn": ["organizerId"],
      "$showId": {
        ".read": "auth != null && data.child('organizerId').val() === auth.uid",
        ".write": "auth != null && (data.child('organizerId').val() === auth.uid || (!data.exists() && newData.child('organizerId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['organizerId', 'name', 'date', 'venue', 'status', 'createdAt']) && newData.child('organizerId').val() === auth.uid"
      }
    },

    "publicShows": {
      "$showId": {
        ".read": "auth != null && data.exists()",
        ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid",
        ".validate": "newData.hasChildren(['name', 'date', 'venue', 'status'])"
      }
    },

    "showParticipants": {
      "$showId": {
        ".read": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid",
        "$participantId": {
          ".read": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid",
          ".write": "auth != null && auth.uid === $participantId && root.child('publicShows').child($showId).exists()",
          ".validate": "newData.hasChildren(['connected', 'device', 'browser', 'joinedAt']) && newData.child('connected').isBoolean() && newData.child('device').isString() && newData.child('browser').isString() && newData.child('joinedAt').isNumber()"
        }
      }
    },

    "showStats": {
      "$showId": {
        ".read": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid",
        ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid"
      }
    }
  }
}
