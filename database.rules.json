{
  "rules": {
    ".read": false,
    ".write": false,
    "organizers": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid", ".validate": "newData.hasChildren(['name', 'role']) && newData.child('role').val() === 'organizer'" } },
    "shows": { ".read": "auth != null && query.orderByChild === 'organizerId' && query.equalTo === auth.uid", ".indexOn": ["organizerId"], "$showId": { ".read": "auth != null && data.child('organizerId').val() === auth.uid", ".write": "auth != null && (data.child('organizerId').val() === auth.uid || (!data.exists() && newData.child('organizerId').val() === auth.uid))", ".validate": "!newData.exists() || (newData.hasChildren(['organizerId', 'name', 'date', 'venue', 'status', 'createdAt']) && newData.child('organizerId').val() === auth.uid && (!newData.child('kind').exists() || newData.child('kind').val() === 'show' || newData.child('kind').val() === 'sports'))" } },
    "publicShows": { "$showId": { ".read": true, ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", ".validate": "!newData.exists() || (newData.hasChildren(['name', 'date', 'venue', 'status']) && (!newData.child('kind').exists() || newData.child('kind').val() === 'show' || newData.child('kind').val() === 'sports'))" } },
    "sportsGames": { "$showId": { ".read": true, ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", ".validate": "!newData.exists() || (newData.hasChildren(['sport', 'homeTeam', 'awayTeam', 'lightTeam', 'updatedAt']) && newData.child('sport').isString() && newData.child('homeTeam').hasChildren(['name', 'primaryColor', 'secondaryColor']) && newData.child('awayTeam').hasChildren(['name', 'primaryColor', 'secondaryColor']) && newData.child('homeTeam').child('name').isString() && newData.child('awayTeam').child('name').isString() && newData.child('homeTeam').child('primaryColor').isString() && newData.child('homeTeam').child('secondaryColor').isString() && newData.child('awayTeam').child('primaryColor').isString() && newData.child('awayTeam').child('secondaryColor').isString() && (newData.child('lightTeam').val() === 'home' || newData.child('lightTeam').val() === 'away' || newData.child('lightTeam').val() === 'custom') && newData.child('updatedAt').isNumber())" } },
    "showParticipants": { "$showId": { ".read": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", "$participantId": { ".read": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", ".write": "auth != null && auth.uid === $participantId && root.child('publicShows').child($showId).exists()", ".validate": "newData.hasChildren(['connected', 'device', 'browser', 'joinedAt']) && newData.child('connected').isBoolean() && newData.child('device').isString() && newData.child('browser').isString() && newData.child('joinedAt').isNumber()" } } },
    "showStats": { "$showId": { ".read": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid" } },
    "sportsInteractions": { "$showId": { ".read": true, ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", "$interactionId": { ".validate": "!newData.exists() || (newData.hasChildren(['type', 'question', 'status', 'createdAt']) && (newData.child('type').val() === 'poll' || newData.child('type').val() === 'question') && (newData.child('status').val() === 'open' || newData.child('status').val() === 'closed'))" } } },
    "sportsResponses": { "$showId": { ".read": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", "$interactionId": { "$uid": { ".write": "auth != null && auth.uid === $uid && root.child('publicShows').child($showId).exists() && root.child('sportsInteractions').child($showId).child($interactionId).child('status').val() === 'open'", ".validate": "newData.hasChildren(['submittedAt']) && newData.child('submittedAt').isNumber()" } } } },
    "sportsResults": { "$showId": { ".read": true, "$interactionId": { ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", ".validate": "!newData.exists() || (newData.hasChildren(['total', 'updatedAt']) && newData.child('total').isNumber() && newData.child('updatedAt').isNumber())" } } },
    "sportsScreen": { "$showId": { ".read": true, ".write": "auth != null && root.child('shows').child($showId).child('organizerId').val() === auth.uid", ".validate": "!newData.exists() || newData.hasChildren(['displayMode', 'updatedAt'])" } }
  }
}
